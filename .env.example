# Banco PostgreSQL (na Vercel: Storage → Neon; a variável DATABASE_URL é criada sozinha)
DATABASE_URL=postgres://askart:askart@localhost:5432/askart

# Segredo do painel: texto aleatório com 32+ caracteres (ex.: openssl rand -hex 32)
PAYLOAD_SECRET=troque-por-um-texto-aleatorio-com-32-caracteres-ou-mais

# Endereço público do site (opcional na Vercel: o endereço do projeto é usado sozinho)
# NEXT_PUBLIC_SERVER_URL=https://askart.com.br

# Fotos e documentos (na Vercel: Storage → Blob; a variável é criada sozinha). Vazio = pasta local.
# BLOB_READ_WRITE_TOKEN=

# Primeiro administrador, criado na implantação se ainda não houver usuários
# ADMIN_EMAIL=
# ADMIN_SENHA=
# ADMIN_NOME=

# Prévia: 1 = carrega os dados de demonstração na implantação. Nunca use no site oficial.
# DADOS_DEMONSTRACAO=1

# Assistente com IA no painel (fase 2)
# ANTHROPIC_API_KEY=
